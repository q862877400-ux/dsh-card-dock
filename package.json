{
  "name": "@local/dsh-card-dock",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "DeepSeek Harness 独立卡包抽屉式消息框与无头浏览器原版分身插件 (@local/dsh-card-dock)：在原生输入框正上方挂载等宽同 24px 圆角的悬停展开聊天记录卡，支持左右两侧拖拽调节整组宽度，并附带基于本机 Edge/Chrome 的 100% 原版 UI 悬浮气泡分身启动器（双向实时同步输入文字、聊天流、模型与权限）。",
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "desktop-launcher",
    "Launch-DeepSeek-Bar-Bubble.bat",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sessions",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=22.14.0",
    "dsh": ">=0.2.2-alpha.2"
  }
}
